# ============================================================
# Stocken Data — variables de entorno (plantilla)
#
# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# ============================================================

# --- Base de datos (credenciales, fuente única) ---
# La imagen postgres:17 crea el rol/BD con estos valores en el primer arranque
# (docker-compose deriva POSTGRES_USER/PASSWORD/DB de aquí). Tambien los usa el
# healthcheck. Deben coincidir con lo embebido en DATABASE_URL y DB_URI.
DB_USER=admin
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=stocken

# --- Backend (Node) ---
NODE_ENV=development
PORT=4000
# El usuario, contrasena y nombre de BD deben coincidir con los de arriba.
DATABASE_URL=postgresql://admin:cambia_esta_contrasena@db:5432/stocken
# Clave para firmar los JWT. Genera una aleatoria, p.ej.: openssl rand -hex 32
SECRET_KEY=genera_una_clave_aleatoria_larga
CHATBOT_URL=http://chatbot_service:8000
# Origenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173

# --- Chatbot service (Python) ---
# Clave de OpenAI. Sin ella el servicio de chatbot no arranca.
OPENAI_API_KEY=sk-tu-clave-de-openai
# Misma BD que arriba; solo cambia el driver (psycopg2).
DB_URI=postgresql+psycopg2://admin:cambia_esta_contrasena@db:5432/stocken

# --- API (frontend / cliente) ---
EXPO_PUBLIC_API=http://localhost:4000/api
